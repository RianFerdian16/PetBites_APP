# Public browser configuration for the Supabase client.
# Copy this file to .env.local and fill in your own project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put OpenAI, Gemini, service-role, or other private API keys in VITE_* variables.
# Configure GEMINI_API_KEY as a Supabase Edge Function secret instead.
