# Ambil dua nilai ini dari Supabase Dashboard > Connect.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Untuk project Supabase lama, kode juga menerima:
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Jangan taruh AI API key di frontend.
# OPENAI_API_KEY disimpan sebagai Supabase Edge Function Secret.
